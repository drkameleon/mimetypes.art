export module [
    ;---------------------------
    ; Private variables
    ;---------------------------

    mimetypes: #./"mimedb.art"

    ;---------------------------
    ; Public methods
    ;---------------------------

    mimetype: method.public [location :string][
        ;; description: « get mimetype(s) from given extension/filepath
        ;; options: [
        ;;      extensions: « get possible file extensions for given mimetype instead
        ;;      best: « get only the best match for given extension/filepath (or null, if none)
        ;; ]
        ;; returns: :block :string :null
        ;; example: {
        ;;      mimetype "jpg"              ; => ["image/jpeg"]
        ;;      mimetype "somefile.jpg"     ; => ["image/jpeg"]
        ;;      mimetype "boom"             ; => []
        ;;
        ;;      mimetype.best "photo.JPG"   ; => "image/jpeg"
        ;;      mimetype.best "file.xml"    ; => "application/xml"
        ;;      mimetype.best "boom"        ; => null
        ;;
        ;;      mimetype.extensions "image/jpeg"
        ;;      ; => ["jpe","jpeg","jpg"]
        ;; }
        extensions?: not? null? attr 'extensions
        best?: not? null? attr 'best

        loc: lower location

        if extensions? [
            ret: []
            loop \mimetypes [k,v][
                if contains? v loc ->
                    'ret ++ k
            ]
            return sort ret
        ]

        ; keep only the last path component (filename),
        ; then whatever follows its last dot
        filename: last split.by:"/" replace loc "\\" "/"

        ; a path whose filename has no extension: nothing to match
        extension: ""
        if or? [filename = loc][contains? filename "."] ->
            extension: last split.by:"." filename

        ret: []
        if key? \mimetypes extension ->
            ret: \mimetypes\[extension]

        ; types are stored in order of preference,
        ; so the best match is always the first one
        if best? -> return (empty? ret) ? -> null -> first ret

        return ret
    ]
]!

;---------------------------
; Testing
;---------------------------

if standalone? [
    inspect mimetype "jpg"
    inspect mimetype "somefile.jpg"
    inspect mimetype "boom"

    inspect mimetype.extensions "image/jpeg"
]